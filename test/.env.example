# Copy to test/.env and fill in your own values.
# Sourced by npm test scripts via `. test/.env`, so use bash `export` syntax.
# test/.env is gitignored.

# --- Tron networks ---
# MNEMONIC_NILE: BIP-39 mnemonic, wrap in double quotes.
#                Required by `npm run test:testnet`.
# PRIVATE_KEY_*: hex private key.
export MNEMONIC_NILE=""
export PRIVATE_KEY_SHASTA=
export PRIVATE_KEY_MAINNET=

# --- EVM networks ---
# PRIVATE_KEY_DEV:    local development account. Required by EVM tests in `npm test`.
# PRIVATE_KEY_DONAU:  BTTC Donau testnet. Required by `npm run test:testnet`.
# PRIVATE_KEY_BTTC:   BTTC mainnet.
export PRIVATE_KEY_DEV=
export PRIVATE_KEY_DONAU=
export PRIVATE_KEY_BTTC=
